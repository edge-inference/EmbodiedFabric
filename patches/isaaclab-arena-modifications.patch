 if args_cli.enable_pinocchio:
     import isaaclab_tasks.manager_based.manipulation.pick_place  # noqa: F401
 
+PINK_ACTION_DIM = 23
+BASE_HEIGHT_DEFAULT = 0.75
+
+
+def _to_batched_action(action: torch.Tensor, num_envs: int) -> torch.Tensor:
+    if action.dim() == 1:
+        action = action.unsqueeze(0)
+    if action.shape[0] == 1 and num_envs > 1:
+        action = action.repeat(num_envs, 1)
+    return action
+
+
+def _convert_se3_to_g1_pink_action(action: torch.Tensor, env: gym.Env) -> torch.Tensor | None:
+    """Map 7D SE3 keyboard command into 23D G1 Pink action."""
+    expected_dim = env.action_manager.total_action_dim
+    if action.shape[-1] != 7 or expected_dim != PINK_ACTION_DIM:
+        return None
+    if "policy" not in env.obs_buf:
+        return None
+    policy_obs = env.obs_buf["policy"]
+    if "right_wrist_pose_pelvis_frame" not in policy_obs or "left_wrist_pose_pelvis_frame" not in policy_obs:
+        return None
+
+    from isaaclab.utils.math import quat_box_plus, quat_from_matrix
+
+    right_wrist_mat = policy_obs["right_wrist_pose_pelvis_frame"]
+    left_wrist_mat = policy_obs["left_wrist_pose_pelvis_frame"]
+    r_pos = right_wrist_mat[:, :3, 3]
+    l_pos = left_wrist_mat[:, :3, 3]
+    r_quat = quat_from_matrix(right_wrist_mat[:, :3, :3])
+    l_quat = quat_from_matrix(left_wrist_mat[:, :3, :3])
+
+    cmd = action.to(device=r_pos.device, dtype=r_pos.dtype)
+    cmd = _to_batched_action(cmd, r_pos.shape[0])
+
+    pink_action = torch.zeros(r_pos.shape[0], PINK_ACTION_DIM, device=r_pos.device, dtype=r_pos.dtype)
+    pink_action[:, 0] = 0.0
+    pink_action[:, 1] = torch.where(cmd[:, 6] < 0.0, 1.0, 0.0)
+    pink_action[:, 2:5] = l_pos
+    pink_action[:, 5:9] = l_quat
+    pink_action[:, 9:12] = r_pos + cmd[:, 0:3]
+    pink_action[:, 12:16] = quat_box_plus(r_quat, cmd[:, 3:6])
+    pink_action[:, 19] = BASE_HEIGHT_DEFAULT
+    return pink_action
+
+
+def _prepare_actions(action: torch.Tensor, env: gym.Env) -> torch.Tensor:
+    action = _to_batched_action(action, env.num_envs)
+    if action.shape[1] == env.action_manager.total_action_dim:
+        return action
+    converted = _convert_se3_to_g1_pink_action(action, env)
+    if converted is not None:
+        return converted
+    raise ValueError(
+        f"Invalid action shape, expected: {env.action_manager.total_action_dim}, received: {action.shape[1]}."
+    )
+
 
