# PhysicAI Environment Variables
# Copy to .env and customize

# HuggingFace token (for gated models)
HF_TOKEN=hf_xxx

# HuggingFace cache directory (optional)
# HF_HOME=~/.cache/huggingface

# CogACT server configuration
COGACT_GPU=0                                        # GPU for primary CogACT server
COGACT_SERVER_URL=http://127.0.0.1:5500/act_batch   # Primary server URL

# Multi-GPU CogACT servers (for parallel inference)
# Start with: docker compose --profile multi-gpu up -d
# COGACT_SERVER_URL_1=http://127.0.0.1:5501/act_batch
# COGACT_SERVER_URL_2=http://127.0.0.1:5502/act_batch
# COGACT_SERVER_URL_3=http://127.0.0.1:5503/act_batch
