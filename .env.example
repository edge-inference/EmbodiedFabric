# PhysicAI Environment Variables
# Copy to .env and customize

# HuggingFace token
HF_TOKEN=hf_xxx
# HF_HOME=~/.cache/huggingface


COGACT_GPU=0
VLM_GPU=1
LEROBOT_GPU=2

# ===========================================
# Container URLs
# ===========================================

# CogACT manipulation server
COGACT_SERVER_URL=http://127.0.0.1:5500/act_batch

# VLM Planner (CogVLM2) for hierarchical mode
# Start: docker compose --profile hierarchical up -d
VLM_PLANNER_URL=http://127.0.0.1:5600/plan

# LeRobot VLA server (SmolVLA/Pi0/GR00T)
# Start: LEROBOT_MODEL=smolvla docker compose --profile lerobot up -d
LEROBOT_SERVER_URL=http://127.0.0.1:5700/predict
LEROBOT_MODEL=smolvla



# ===========================================
# Run Modes
# ===========================================
#
# 1. HIERARCHICAL (VLM planner -> experts)
#    docker compose --profile hierarchical up -d
#    python examples/floorplan_4zone.py --vla hierarchical
#
# 2. END-TO-END (LeRobot models)
#    LEROBOT_MODEL=smolvla docker compose --profile lerobot up -d
#    python examples/floorplan_4zone.py --vla smolvla --control-mode low_level
#
# 3. LOCAL (no containers, loads models in-process)
#    python examples/floorplan_4zone.py --vla pi0

