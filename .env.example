# PhysicAI Environment Variables
# Copy to .env and fill in your values.

# HuggingFace token
HF_TOKEN=hf_xxx
# HF_HOME=~/.cache/huggingface

# GPU assignment for LeRobot server container
LEROBOT_GPU=0

# LeRobot VLA server (SmolVLA/Pi0)
# Start: LEROBOT_MODEL=smolvla docker compose --profile lerobot up -d
LEROBOT_SERVER_URL=http://127.0.0.1:5700/predict
LEROBOT_MODEL=smolvla
